<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<HBox xmlns:fx="http://javafx.com/fxml/1" prefHeight="697.0" prefWidth="1058.0"
      xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.musigma.controllers.workspaces.StockController">
    <VBox minWidth="200" prefWidth="200" spacing="8.0">
        <Button maxWidth="1.7976931348623157E308" onAction="#addStock" text="Ajouter stock"/>
        <Separator VBox.vgrow="NEVER"/>
        <Label fx:id="total" wrapText="true"/>
        <Label fx:id="missing" wrapText="true" style="-fx-text-fill: -color-danger-fg;"/>
        <Separator VBox.vgrow="NEVER"/>
        <Label wrapText="true" style="-fx-text-fill: -color-fg-muted;"
               text="Un stock limité est une ressource que les tickets ne peuvent pas dépasser (ex : places de parking). Sinon, la quantité est ce que vous prévoyez d'acheter."/>
        <padding>
            <Insets left="10.0" right="8.0" top="8.0"/>
        </padding>
    </VBox>
    <TableView fx:id="tableView" prefHeight="615.0" prefWidth="1058.0" HBox.hgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="250.0" text="Objet"/>
            <TableColumn fx:id="quantityColumn" prefWidth="110.0" text="Quantité"/>
            <TableColumn fx:id="fixedColumn" prefWidth="70.0" text="Limité"/>
            <TableColumn fx:id="consumedColumn" prefWidth="160.0" text="Consommation"/>
            <TableColumn fx:id="priceColumn" prefWidth="110.0" text="Prix unitaire (€)"/>
            <TableColumn fx:id="actionColumn" prefWidth="100.0" sortable="false" text="Actions"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</HBox>
