<?xml version="1.0" encoding="UTF-8"?>

<?import com.calendarfx.view.CalendarView?>
<?import com.musigma.controllers.components.IntTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" prefHeight="697.0" prefWidth="1058.0"
      xmlns="http://javafx.com/javafx/22" fx:controller="com.musigma.controllers.workspaces.CalendarController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <ComboBox fx:id="artisteChoice" prefWidth="170.0" promptText="Artiste"/>
                <ComboBox fx:id="sceneChoice" prefWidth="175.0" promptText="Scène"/>
                <DatePicker fx:id="dayChoice" prefWidth="140.0" promptText="Jour"/>
                <ComboBox fx:id="timeChoice" prefWidth="95.0" promptText="Heure"/>
                <IntTextField fx:id="durationField" maxHeight="-Infinity" prefWidth="80.0" positive="true" notNull="true"
                              promptText="Durée"/>
                <Label text="min"/>
                <Button onAction="#planRepresentation" styleClass="accent" text="Planifier"/>
            </children>
            <padding>
                <Insets bottom="6.0" left="10.0" right="10.0" top="6.0"/>
            </padding>
        </HBox>
        <CalendarView fx:id="calendarView" VBox.vgrow="ALWAYS"/>
    </children>
</VBox>
